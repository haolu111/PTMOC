# 复制本文件为 .env 后填入真实值：
#   cp .env.example .env
#
# .env 已被 gitignore，不会提交到 GitHub。

AMAP_WEB_KEY=your_amap_web_service_key_here

# Docker Compose host binding. Use 0.0.0.0 only when other machines need access.
PTMOC_BIND_ADDRESS=127.0.0.1
PTMOC_PORT=5173

# Limit the Java heap relative to the container memory limit.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
